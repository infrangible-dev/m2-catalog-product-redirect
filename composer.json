{
    "name": "infrangible/m2-catalog-product-redirect",
    "description": "Sends visitors of disabled or out-of-stock product pages to another product, either with a permanent or temporary redirect or by showing the other product under the same address.",
    "type": "magento2-module",
    "version": "1.0.1",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Catalog",
        "SEO",
        "redirect disabled products",
        "redirect out-of-stock products",
        "product 301 redirect"
    ],
    "homepage": "https://github.com/infrangible-dev/m2-catalog-product-redirect",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.1",
        "magento/framework": "~101.0.0|~102.0.0|~103.0.0",
        "infrangible/m2-foundation": "~2.2.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\CatalogProductRedirect\\": "src"
        }
    }
}
